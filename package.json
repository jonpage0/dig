    "preview": "node --import ./scripts/typescript.mjs scripts/preview.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/mcp-extensions": "0.2.0",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "clsx": "2.1.1",
    "marked": "18.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "esbuild": "0.28.2",
    "expect": "30.5.2",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
