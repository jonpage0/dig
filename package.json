{
  "name": "dig",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node --import ./scripts/typescript.mjs scripts/build.mjs",
    "test": "node --conditions=development --import ./scripts/typescript.mjs --test src/core/*.test.ts src/sources/*.test.ts src/sources/*/*.test.ts src/service/*.test.ts test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run build && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "live-check": "node scripts/live-check.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@effect/ai-typesafe": "4.1.5",
    "@effect/atom-react": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@effect/sql-sqlite-node": "4.1.5",
    "@huggingface/tokenizers": "0.2.0",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/react-router": "1.170.45",
    "clsx": "2.1.1",
    "effect": "4.1.5",
    "marked": "18.0.7",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "expect": "30.5.2",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
