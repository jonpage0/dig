{
  "name": "dig",
  "version": "0.2.29",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node --import ./scripts/typescript.mjs scripts/build.mjs",
    "test": "node --import ./scripts/typescript.mjs --test test/*.test.mjs src/providers/*.test.ts src/providers/tools/*.test.ts",
