  "license": "MIT",
  "scripts": {
    "build": "node --import ./scripts/typescript.mjs scripts/build.mjs",
    "test": "node --conditions=development --import ./scripts/typescript.mjs --test test/*.test.mjs src/providers/*.test.ts src/providers/tools/*.test.ts",
