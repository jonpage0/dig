+def _safe_diagnostic(value) -> str:
+    text = str(value)
+    # HTTP exception strings may contain complete request URLs.
+    text = re.sub(r"(?i)(api_key|access_token|token|key)=([^&\s]+)", r"\1=[redacted]", text)
+    for name, secret in os.environ.items():
+        if secret and any(part in name.upper() for part in ("KEY", "TOKEN", "SECRET", "PASSWORD")):
+            text = text.replace(secret, "[redacted]")
+    return text[:1000]
+
+
+class _SourceDiagnostics(logging.Handler):
+    """Capture upstream swallowed errors without mixing concurrent sources."""
+    def __init__(self):
+        super().__init__(logging.WARNING)
+        self.thread = threading.get_ident()
+        self.errors = []
+        self.warnings = []
+
+    def emit(self, record):
+        if record.thread != self.thread:
+            return
+        target = self.errors if record.levelno >= logging.ERROR else self.warnings
+        target.append(_safe_diagnostic(record.getMessage()))
+
+
+def _search_with_diagnostics(searcher, query, max_results, kwargs):
+    capture = _SourceDiagnostics()
+    root = logging.getLogger()
+    root.addHandler(capture)
+    papers = []
+    searcher.empty_result_confirmed = False
+    try:
+        papers = [p.to_dict() for p in searcher.search(query, max_results=max_results, **kwargs)]
+        if not papers and not capture.errors and not searcher.empty_result_confirmed:
+            capture.warnings.append("Connector returned no papers without a validated empty provider response; not confirmed no matches")
+    except Exception as exc:
+        capture.errors.append(_safe_diagnostic(exc))
+    finally:
+        root.removeHandler(capture)
+    return papers, capture.errors, capture.warnings
+
+
+async def _async_search(searcher: Any, query: str, max_results: int, **kwargs):
+    return await asyncio.to_thread(_search_with_diagnostics, searcher, query, max_results, kwargs)
 
 
