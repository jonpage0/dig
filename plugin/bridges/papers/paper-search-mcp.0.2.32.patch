@@ -0,0 +1,60 @@
+"""OMP E-utilities coordination shared by PubMed/PMC threads and CLI processes.
+
+One per-user advisory lock deliberately uses the conservative keyless rate even
+when a key is present. Other programs/hosts on the same IP are not coordinated.
+"""
+import fcntl
+import logging
+import threading
+import time
+from pathlib import Path
+from xml.etree import ElementTree as ET
+
+import requests
+from .config import get_env
+
+logger = logging.getLogger(__name__)
+_LOCK = threading.Lock()
+# NCBI permits 3 requests/s without a key; leave a small scheduling margin.
+_INTERVAL_SECONDS = 0.35
+
+
+def ncbi_get(url, params, session=None):
+    params = dict(params)
+    key = get_env("NCBI_API_KEY", "")
+    if key:
+        params["api_key"] = key
+    params["tool"] = "paper-search-mcp"
+    cache = Path.home() / ".cache" / "paper-search-mcp"
+    cache.mkdir(parents=True, exist_ok=True)
+    with _LOCK, (cache / "ncbi.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        try:
+            # Hold through completion: separate processes cannot dispatch a burst.
+            time.sleep(_INTERVAL_SECONDS)
+            response = (session or requests).get(url, params=params, timeout=30)
+            if response.status_code != 200:
+                raise RuntimeError(f"NCBI HTTP {response.status_code}; request failed, not no matches")
+            root = ET.fromstring(response.content)
+            if root.tag.upper() == "ERROR" or root.find(".//ERROR") is not None:
+                raise RuntimeError("NCBI returned an E-utilities error payload")
+            if root.tag not in ("eSearchResult", "eSummaryResult", "PubmedArticleSet", "pmc-articleset"):
+                raise RuntimeError("NCBI returned an unexpected XML payload (possibly a bot block)")
+            # ESearch ErrorList describes query interpretation, not request failure.
+            diagnostics = root.findall(".//ErrorList/*") + root.findall(".//WarningList/*")
+            if diagnostics:
+                details = "; ".join(f"{item.tag}: {''.join(item.itertext()).strip()}" for item in diagnostics)
+                translation = root.findtext("QueryTranslation")
+                logger.warning(
+                    "NCBI query interpretation warning; exact-query coverage is not confirmed: %s; "
+                    "QueryTranslation: %s",
+                    details,
+                    translation or "not supplied",
+                )
+
+            return response
+        except requests.RequestException as exc:
+            # requests errors can include the credential-bearing URL.
+            raise RuntimeError(f"NCBI transport failure ({type(exc).__name__})") from None
+        finally:
+            fcntl.flock(lock, fcntl.LOCK_UN)
