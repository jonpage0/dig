+
+
+def openalex_budget(response):
+    # Only numeric allowlisted budget headers; never headers containing credentials.
+    budget = {}
+    for name in ("limit", "limit-usd", "remaining", "credits-used", "reset"):
+        raw = response.headers.get(f"X-RateLimit-{name}", "")
+        try:
+            value = float(raw)
+            if 0 <= value < float("inf"):
+                budget[name] = value
+        except (ValueError, TypeError):
+            pass
+    return budget
+
+
+def openalex_cost_usd(data):
+    # OpenAlex's own usage cost for this request (meta.cost_usd); None when missing or invalid.
+    meta = data.get("meta") if isinstance(data, dict) else None
+    cost = meta.get("cost_usd") if isinstance(meta, dict) else None
+    if isinstance(cost, (int, float)) and not isinstance(cost, bool) and 0 <= cost < float("inf"):
+        return float(cost)
+    return None
+
