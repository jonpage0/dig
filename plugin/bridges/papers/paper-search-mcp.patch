+import argparse, asyncio, json
+from types import SimpleNamespace
+from unittest.mock import Mock
+from paper_search_mcp import cli
+from paper_search_mcp.academic_platforms.openalex import OpenAlexSearcher
+
+def test_dig_health_distinguishes_unknown_empty_and_confirmed_empty(monkeypatch,capsys):
+    class Source:
+        def search(self,*args,**kwargs): return []
+    source=Source()
+    monkeypatch.setattr(cli,'_get_searcher',lambda name:source)
+    args=argparse.Namespace(sources='arxiv',query='fixture',max_results=1,year='',sort='relevance')
+    asyncio.run(cli.cmd_search(args));assert json.loads(capsys.readouterr().out)['source_status']['arxiv']=='partial'
+    def empty(*args,**kwargs): source.empty_result_confirmed=True;return []
+    source.search=empty
+    asyncio.run(cli.cmd_search(args));assert json.loads(capsys.readouterr().out)['source_status']['arxiv']=='empty'
+
+def test_dig_source_failure_is_explicit(monkeypatch,capsys):
+    class Source:
+        def search(self,*args,**kwargs): raise RuntimeError('provider refused')
+    monkeypatch.setattr(cli,'_get_searcher',lambda name:Source())
+    args=argparse.Namespace(sources='arxiv',query='fixture',max_results=1,year='',sort='relevance')
+    asyncio.run(cli.cmd_search(args));value=json.loads(capsys.readouterr().out)
+    assert value['source_status']['arxiv']=='failed'
+    assert 'provider refused' in value['errors']['arxiv']
+
+def test_dig_openalex_captures_each_response_and_transport_failure():
